rules_version = '2';

// Firebase Storage Security Rules for Avirbhav Digital Marketing CMS
service firebase.storage {
  match /b/{bucket}/o {
    
    // Website CMS uploaded assets (hero images, course graphics, banners)
    match /website_content/{allPaths=**} {
      // Public read access for web visitors to view CMS images
      allow read: if true;
      
      // Upload/write restricted to authenticated admin
      // Enforces image content types and maximum 10MB file size
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
                   
      // Deletion restricted to authenticated admin
      allow delete: if request.auth != null;
    }
    
    // General fallback rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
